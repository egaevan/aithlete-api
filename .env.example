# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
APP_ENV=development

# TLS Configuration (set TLS_ENABLED=true to enable HTTPS)
TLS_ENABLED=false
TLS_CERT_FILE=./certs/cert.pem
TLS_KEY_FILE=./certs/key.pem

# Database Configuration (for future use)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aithlete
DB_SSLMODE=disable

# JWT Configuration
JWT_SECRET=dev-secret
JWT_EXPIRATION_HOURS=24

# Migration URL (used by golang-migrate CLI)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/aithlete?sslmode=disable
